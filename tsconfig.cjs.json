{
  // CommonJS output, so `require('vecline')` works alongside `import`.
  //
  // The source is written as ESM with explicit `.js` specifiers. TypeScript
  // rewrites those to `require()` calls here and the specifiers still resolve,
  // because the emitted files really are named `.js`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist/cjs",
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "src/cli.ts"]
}
